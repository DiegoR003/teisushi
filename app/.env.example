# Copia este archivo como .env (local, no versionado) y/o configura estas
# mismas variables en Vercel: Project Settings -> Environment Variables.

# Secret de reCAPTCHA v2 (el mismo que ya se usaba en php/contact.php)
RECAPTCHA_SECRET=

# API key de https://resend.com (Settings -> API Keys)
RESEND_API_KEY=

# A dónde llegan los mensajes del formulario
CONTACT_TO_EMAIL=info@teisushi.com

# Remitente. Mientras no verifiques un dominio propio en Resend, usa
# "Tei Sushi <onboarding@resend.dev>" (solo entrega a la cuenta dueña del API key).
CONTACT_FROM_EMAIL=Tei Sushi <onboarding@resend.dev>
